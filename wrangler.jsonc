{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renato-100-lanches",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none"},
  "d1_databases": [{"binding": "DB", "database_name": "renato-pedidos", "database_id": "e413d795-6e94-40c8-93a2-e9346fda8a3d", "migrations_dir": "cloudflare/migrations"}],
  "observability": {"enabled": false},
  "vars": {"PUBLIC_ORIGIN": "https://renato-100-lanches.betaniaaa.workers.dev"}
}
