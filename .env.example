# Defina estas variáveis no ambiente do servidor; o programa não lê .env automaticamente.
# ADMIN_USER: usuário do responsável (renato por padrão).
# ADMIN_PASSWORD: senha forte com pelo menos 12 caracteres. Não use valores de exemplo.
# PUBLIC_ORIGIN: endereço HTTPS público exato, sem barra final.
# DATA_DIR: diretório persistente privado, fora de dist.
# HOST: 127.0.0.1 por padrão; altere somente na configuração da hospedagem.
# PORT: 4173 por padrão.

PUSH_SUBJECT=https://seu-dominio.com.br

# Somente no Cloudflare Tunnel protegido: IPs exatos do proxy; não habilite em uma origem pública direta.
# TRUST_PROXY_FROM=127.0.0.1,::1
